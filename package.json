{
  "name": "decky-dsr-fov",
  "version": "0.0.1",
  "description": "Decky plugin for adjusting Dark Souls Remastered FOV.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "package": "scripts/build-plugin.sh",
    "copy:deck": "scripts/copy-to-steamdeck.sh",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "decky",
    "plugin",
    "dark-souls-remastered",
    "fov",
    "steam-deck",
    "deck"
  ],
  "author": "Joseph",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
